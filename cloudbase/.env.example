# Public client settings only; copy to cloudbase/.env locally.
# Client guard rejects keys whose decoded role is not anon.
SHIRI_CLOUDBASE_ENV_ID=YOUR_CLOUDBASE_ENV_ID
SHIRI_CLOUDBASE_PUBLISHABLE_KEY=
SHIRI_CLOUDBASE_TEST_URL=https://YOUR_ENV-YOUR_ACCOUNT.ap-shanghai.app.tcloudbase.com/shiri-test
# Do not add service_role, API Key, SecretId, SecretKey or DB passwords here.

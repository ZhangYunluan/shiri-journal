# Set ONLY in CloudBase HTTP Function configuration. Never copy to src/ or APK.
SHIRI_ENV_ID=YOUR_CLOUDBASE_ENV_ID
SHIRI_STORAGE_SERVICE_KEY=
SHIRI_ALLOWED_ORIGINS=https://localhost,http://localhost
# Add your HTTPS website origin separated by commas if also serving the web app.

# CloudBase gateway handles CORS; function still validates origin and user authorization.
SHIRI_CORS_OWNER=gateway

SHIRI_ENV_ID=YOUR_CLOUDBASE_ENV_ID
SHIRI_AI_API_KEY=
SHIRI_AI_BASE_URL=https://tokenhub.tencentmaas.com/v1
SHIRI_AI_MODEL=deepseek/deepseek-flash
# Only server-side CloudBase service_role credential for quota RPC. Never use Publishable Key here.
SHIRI_AI_SERVICE_KEY=
SHIRI_ALLOWED_ORIGINS=https://localhost
SHIRI_CORS_OWNER=gateway
